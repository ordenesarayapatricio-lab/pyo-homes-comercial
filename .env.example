# Puerto en el que escucha el servidor (EasyPanel lo inyecta automáticamente)
PORT=3000

# Supabase (proyecto compartido con el chatbot de WhatsApp) — la anon key es
# pública por diseño (protegida por RLS), pero nunca commitees la service role key.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Webhook de n8n a notificar cuando se crea un lead nuevo desde el CRM (Leads → + Nuevo Lead).
# Si se deja vacío, el servidor solo loggea el payload que habría enviado (no rompe nada).
N8N_NEW_LEAD_WEBHOOK_URL=

# Webhook de n8n para campañas masivas (Leads → seleccionar varios → "Enviar Propiedad").
# Igual que arriba: vacío = solo se loggea, no rompe nada.
N8N_BULK_CAMPAIGN_WEBHOOK_URL=

# Necesaria para que /api/webhooks/booking (agendamiento de visitas) escriba en Supabase
# sin depender de una sesión de navegador — usa la service role key, nunca la anon key.
SUPABASE_SECRET_KEY=

# Secreto del webhook de Cal.com (Cal.com → Settings → Developer → Webhooks), usado para
# verificar la firma HMAC de cada evento recibido en /api/webhooks/booking. Si se deja
# vacío, el endpoint no puede validar la firma (solo para desarrollo local).
CAL_COM_WEBHOOK_SECRET=
